# Build output
bin/

# OS files
.DS_Store

# Go
binary/friendo

# Node
node_modules/
# package-lock.json files are COMMITTED on purpose — do not ignore them. The admin
# SPA is built from them, and the build output is committed + go:embed-ed into the
# binary. Without a lockfile a fresh clone (i.e. CI) resolves the caret ranges to
# whatever is newest and produces different bundles than the ones in the tree, which
# is exactly what the `bundles-current` CI check fails on.

# Wrangler local state (D1, R2 simulation)
world/.wrangler/

# SQLite databases (created at runtime)
*.db
*.db-journal
*.db-wal
*.db-shm

# Page-bundle gallery mirror (regenerated from content/ on every build; the
# images under content/<collection>/<slug>/ are the source of truth)
**/assets/galleries/

# Dist output
dist/

# Wrangler secrets (local dev)
.dev.vars

# Wrangler local state
.wrangler/
