[
  {
    "name": "nested-forloop",
    "template": "{% for a in collections.rt %}[{{ forloop.Counter }}{% if forloop.First %}F{% endif %}{% if forloop.Last %}L{% endif %}:{% for b in collections.rt %}({{ forloop.Counter }}){% endfor %}]{% endfor %}",
    "posts": [
      {
        "collection": "rt",
        "slug": "r1",
        "title": "R1",
        "status": "published",
        "created": "2020-01-02T00:00:00Z"
      },
      {
        "collection": "rt",
        "slug": "r2",
        "title": "R2",
        "status": "published",
        "created": "2020-01-01T00:00:00Z"
      }
    ],
    "expect": "[1F:(1)(2)][2L:(1)(2)]"
  },
  {
    "name": "autoescape",
    "template": "{% for e in collections.esc %}{{ e.title }}{% endfor %}",
    "posts": [
      {
        "collection": "esc",
        "slug": "e1",
        "title": "<b>\"Tom & 'Jerry'\"</b>",
        "status": "published",
        "created": "2020-01-01T00:00:00Z"
      }
    ],
    "expect": "&lt;b&gt;&quot;Tom &amp; &#39;Jerry&#39;&quot;&lt;/b&gt;"
  },
  {
    "name": "filters",
    "template": "{% for f in collections.fl %}{{ f.title|upper }}|{{ f.title|lower }}|{{ f.title|capfirst }}{% endfor %}|{{ collections.fl|length }}",
    "posts": [
      {
        "collection": "fl",
        "slug": "f1",
        "title": "hello World",
        "status": "published",
        "created": "2020-01-01T00:00:00Z"
      }
    ],
    "expect": "HELLO WORLD|hello world|Hello World|1"
  },
  {
    "name": "conditional",
    "template": "{% for a in collections.cond %}{{ a.title }}:{% if a.fields.featured %}*{% else %}-{% endif %} {% endfor %}",
    "posts": [
      {
        "collection": "cond",
        "slug": "c1",
        "title": "A",
        "status": "published",
        "created": "2020-01-02T00:00:00Z",
        "fields": {
          "featured": true
        }
      },
      {
        "collection": "cond",
        "slug": "c2",
        "title": "B",
        "status": "published",
        "created": "2020-01-01T00:00:00Z",
        "fields": {
          "featured": false
        }
      }
    ],
    "expect": "A:* B:- "
  },
  {
    "name": "draft-excluded",
    "template": "{% for d in collections.dr %}{{ d.title }} {% endfor %}",
    "posts": [
      {
        "collection": "dr",
        "slug": "d1",
        "title": "Published",
        "status": "published",
        "created": "2020-01-02T00:00:00Z"
      },
      {
        "collection": "dr",
        "slug": "d2",
        "title": "Draft",
        "status": "draft",
        "created": "2020-01-01T00:00:00Z"
      }
    ],
    "expect": "Published "
  },
  {
    "name": "group-key-that-names-no-group",
    "template": "{% for d in collections.docs|sort_by:\"fields.weight\" %}{% if d.fields.group == \"Concepts\" %}{{ d.title }}{% if d.group %}!{% endif %};{% endif %}{% endfor %}{{ collections.docs|in_group:\"Concepts\"|length }}",
    "posts": [
      {
        "collection": "docs",
        "slug": "a",
        "title": "A",
        "status": "published",
        "created": "2020-01-02T00:00:00Z",
        "fields": {
          "group": "Concepts",
          "weight": 2
        }
      },
      {
        "collection": "docs",
        "slug": "b",
        "title": "B",
        "status": "published",
        "created": "2020-01-01T00:00:00Z",
        "fields": {
          "group": "Concepts",
          "weight": 1
        }
      },
      {
        "collection": "docs",
        "slug": "c",
        "title": "C",
        "status": "published",
        "created": "2020-01-01T00:00:00Z",
        "fields": {
          "group": "Hosting",
          "weight": 3
        }
      }
    ],
    "expect": "B;A;2"
  }
]
