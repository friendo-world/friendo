    "expect": { "status": 200, "json": { "synced": 1, "authors": 1 } }
  },
  {
    "name": "pull users returns an author-profiles array",
    "method": "GET", "path": "/pull/users",
    "expect": { "status": 200, "json": { "authors.0.name": "Owner" } }
  },

