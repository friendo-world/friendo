[
  {
    "name": "me is unauthorized before setup",
    "method": "GET", "path": "/me",
    "expect": { "status": 401 }
  },
  {
    "name": "setup status reports a first-run site",
    "method": "GET", "path": "/setup",
    "expect": { "status": 200, "json": { "needsSetup": true, "hasLegacyAdmin": false } }
  },
  {
    "name": "setup creates the first owner",
    "method": "POST", "path": "/setup",
    "body": { "email": "owner@test.com", "name": "Owner", "password": "password12345" },
    "expect": { "status": 201, "json": { "user.email": "owner@test.com", "user.role": "owner" } }
  },
  {
    "name": "me returns the logged-in owner",
    "method": "GET", "path": "/me",
    "expect": { "status": 200, "json": { "user.email": "owner@test.com", "user.role": "owner" } },
    "capture": { "ownerId": "user.id" }
  },
  {
    "name": "setup status reports done after setup",
    "method": "GET", "path": "/setup",
    "expect": { "status": 200, "json": { "needsSetup": false } }
  },
  {
    "name": "setup is rejected once an admin exists",
    "method": "POST", "path": "/setup",
    "body": { "email": "two@test.com", "name": "Two", "password": "password12345" },
    "expect": { "status": 409 }
  },
  {
    "name": "collections lists the defaults with zero counts",
    "method": "GET", "path": "/collections",
    "expect": {
      "status": 200,
      "length": { "collections": 3 },
      "json": { "collections.0.name": "blog", "collections.0.count": 0, "collections.2.name": "posts" }
    }
  },
  {
    "name": "create a record",
    "method": "POST", "path": "/collections/blog/records",
    "body": { "title": "Hello", "slug": "hello", "body": "first post", "status": "published" },
    "expect": {
      "status": 201,
      "json": { "record.title": "Hello", "record.collection": "blog", "record.status": "published" }
    },
    "capture": { "recordId": "record.id" }
  },
  {
    "name": "fetch the record by id (round-trips captured id)",
    "method": "GET", "path": "/records/${recordId}",
    "expect": { "status": 200, "json": { "record.id": "${recordId}", "record.slug": "hello" } }
  },
  {
    "name": "list records in the collection",
    "method": "GET", "path": "/collections/blog/records",
    "expect": { "status": 200, "length": { "records": 1 } }
  },
  {
    "name": "collections count reflects the new record",
    "method": "GET", "path": "/collections",
    "expect": { "status": 200, "json": { "collections.0.name": "blog", "collections.0.count": 1 } }
  },
  {
    "name": "update the record",
    "method": "PUT", "path": "/records/${recordId}",
    "body": { "title": "Edited", "slug": "hello", "body": "changed", "status": "draft" },
    "expect": { "status": 200, "json": { "record.title": "Edited", "record.status": "draft" } }
  },
  {
    "name": "delete the record",
    "method": "DELETE", "path": "/records/${recordId}",
    "expect": { "status": 204 }
  },
  {
    "name": "fetching the deleted record is a 404",
    "method": "GET", "path": "/records/${recordId}",
    "expect": { "status": 404 }
  },
  {
    "name": "create an editor user",
    "method": "POST", "path": "/users",
    "body": { "email": "ed@test.com", "name": "Ed", "password": "password12345", "role": "editor" },
    "expect": { "status": 201, "json": { "user.email": "ed@test.com", "user.role": "editor" } },
    "capture": { "editorId": "user.id" }
  },
  {
    "name": "assigning an unknown role is forbidden",
    "method": "POST", "path": "/users",
    "body": { "email": "x@test.com", "name": "X", "password": "password12345", "role": "superadmin" },
    "expect": { "status": 403 }
  },
  {
    "name": "a short password is rejected",
    "method": "POST", "path": "/users",
    "body": { "email": "y@test.com", "name": "Y", "password": "short", "role": "member" },
    "expect": { "status": 400 }
  },
  {
    "name": "list users (owner + editor)",
    "method": "GET", "path": "/users",
    "expect": { "status": 200, "length": { "users": 2 } }
  },
  {
    "name": "update the editor (name + role)",
    "method": "PUT", "path": "/users/${editorId}",
    "body": { "name": "Ed Renamed", "role": "member" },
    "expect": { "status": 200, "json": { "user.name": "Ed Renamed", "user.role": "member" } }
  },
  {
    "name": "settings reflects site name and counts",
    "method": "GET", "path": "/settings",
    "expect": { "status": 200, "json": { "site.name": "testsite", "users": 2, "collections": 0 } }
  },
  {
    "name": "delete the editor",
    "method": "DELETE", "path": "/users/${editorId}",
    "expect": { "status": 204 }
  },
  {
    "name": "deleting your own account is rejected",
    "method": "DELETE", "path": "/users/${ownerId}",
    "expect": { "status": 400 }
  },
  {
    "name": "login with the wrong password fails",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "wrongpassword" },
    "expect": { "status": 401 }
  },
  {
    "name": "logout ends the session",
    "method": "POST", "path": "/auth/logout",
    "expect": { "status": 204 }
  },
  {
    "name": "me is unauthorized after logout",
    "method": "GET", "path": "/me",
    "expect": { "status": 401 }
  },
  {
    "name": "login with the correct password succeeds",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200, "json": { "user.email": "owner@test.com", "user.role": "owner" } }
  },
  {
    "name": "create a post to receive comments",
    "method": "POST", "path": "/collections/blog/records",
    "body": { "title": "Commentable", "slug": "commentable", "body": "hi", "status": "published" },
    "expect": { "status": 201 },
    "capture": { "commentPostId": "record.id" }
  },
  {
    "name": "request an OTP code for a new member",
    "method": "POST", "path": "/auth/request-code",
    "body": { "email": "member@test.com" },
    "expect": { "status": 200, "json": { "sent": true } },
    "capture": { "otp": "code" }
  },
  {
    "name": "requesting another code immediately is rate-limited",
    "method": "POST", "path": "/auth/request-code",
    "body": { "email": "member@test.com" },
    "expect": { "status": 429 }
  },
  {
    "name": "verifying a wrong code fails",
    "method": "POST", "path": "/auth/verify-code",
    "body": { "email": "member@test.com", "code": "wrong-code" },
    "expect": { "status": 401 }
  },
  {
    "name": "verifying the OTP code logs in as a member",
    "method": "POST", "path": "/auth/verify-code",
    "body": { "email": "member@test.com", "code": "${otp}" },
    "expect": { "status": 200, "json": { "user.email": "member@test.com", "user.role": "member" } }
  },
  {
    "name": "me returns the verified member",
    "method": "GET", "path": "/me",
    "expect": { "status": 200, "json": { "user.email": "member@test.com", "user.role": "member" } }
  },
  {
    "name": "a member cannot reach admin endpoints",
    "method": "GET", "path": "/users",
    "expect": { "status": 403 }
  },
  {
    "name": "a member posts a comment (starts pending)",
    "method": "POST", "path": "/posts/${commentPostId}/comments",
    "body": { "body": "First!" },
    "expect": {
      "status": 201,
      "json": { "comment.body": "First!", "comment.status": "pending", "comment.author_name": "member" }
    },
    "capture": { "commentId": "comment.id" }
  },
  {
    "name": "the comment author sees their own pending comment (but can't moderate)",
    "method": "GET", "path": "/posts/${commentPostId}/comments",
    "expect": {
      "status": 200,
      "json": { "can_moderate": false, "comments.0.id": "${commentId}", "comments.0.mine": true, "comments.0.status": "pending" },
      "length": { "comments": 1 }
    }
  },
  {
    "name": "a member cannot access the moderation queue",
    "method": "GET", "path": "/comments",
    "expect": { "status": 403 }
  },
  {
    "name": "a member posts a second comment",
    "method": "POST", "path": "/posts/${commentPostId}/comments",
    "body": { "body": "Oops, double post" },
    "expect": { "status": 201 },
    "capture": { "oopsId": "comment.id" }
  },
  {
    "name": "a member deletes their own comment",
    "method": "DELETE", "path": "/comments/${oopsId}",
    "expect": { "status": 204 }
  },
  {
    "name": "a different visitor signs in",
    "method": "POST", "path": "/auth/request-code",
    "body": { "email": "other@test.com" },
    "expect": { "status": 200 },
    "capture": { "otpOther": "code" }
  },
  {
    "name": "the other visitor verifies",
    "method": "POST", "path": "/auth/verify-code",
    "body": { "email": "other@test.com", "code": "${otpOther}" },
    "expect": { "status": 200 }
  },
  {
    "name": "a non-author does not see the pending comment",
    "method": "GET", "path": "/posts/${commentPostId}/comments",
    "expect": { "status": 200, "length": { "comments": 0 }, "json": { "can_moderate": false } }
  },
  {
    "name": "a member cannot delete someone else's comment",
    "method": "DELETE", "path": "/comments/${commentId}",
    "expect": { "status": 403 }
  },
  {
    "name": "owner logs back in to moderate",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "the moderation queue lists the pending comment",
    "method": "GET", "path": "/comments?status=pending",
    "expect": { "status": 200, "length": { "comments": 1 }, "json": { "comments.0.id": "${commentId}" } }
  },
  {
    "name": "approve the comment",
    "method": "PUT", "path": "/comments/${commentId}",
    "body": { "status": "approved" },
    "expect": { "status": 200, "json": { "comment.status": "approved" } }
  },
  {
    "name": "an invalid moderation status is rejected",
    "method": "PUT", "path": "/comments/${commentId}",
    "body": { "status": "bogus" },
    "expect": { "status": 400 }
  },
  {
    "name": "public comment read now shows the approved comment",
    "method": "GET", "path": "/posts/${commentPostId}/comments",
    "expect": {
      "status": 200,
      "length": { "comments": 1 },
      "json": { "comments.0.body": "First!", "comments.0.author_name": "member" }
    }
  },
  {
    "name": "owner logs out",
    "method": "POST", "path": "/auth/logout",
    "expect": { "status": 204 }
  },
  {
    "name": "anonymous cannot post a comment",
    "method": "POST", "path": "/posts/${commentPostId}/comments",
    "body": { "body": "nope" },
    "expect": { "status": 401 }
  },
  {
    "name": "deleting a comment requires admin, not anonymous",
    "method": "DELETE", "path": "/comments/${commentId}",
    "expect": { "status": 401 }
  },
  {
    "name": "reaction counts are public and start empty",
    "method": "GET", "path": "/reactions?target_type=post&target_id=${commentPostId}",
    "expect": { "status": 200, "length": { "reactions": 0 } }
  },
  {
    "name": "anonymous cannot react",
    "method": "POST", "path": "/reactions",
    "body": { "target_type": "post", "target_id": "${commentPostId}", "emoji": "👍" },
    "expect": { "status": 401 }
  },
  {
    "name": "owner logs in to interact with community features",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "add a reaction",
    "method": "POST", "path": "/reactions",
    "body": { "target_type": "post", "target_id": "${commentPostId}", "emoji": "👍" },
    "expect": {
      "status": 200,
      "json": { "reacted": true, "reactions.0.emoji": "👍", "reactions.0.count": 1, "reactions.0.reacted": true }
    }
  },
  {
    "name": "reacting again toggles it off",
    "method": "POST", "path": "/reactions",
    "body": { "target_type": "post", "target_id": "${commentPostId}", "emoji": "👍" },
    "expect": { "status": 200, "json": { "reacted": false }, "length": { "reactions": 0 } }
  },
  {
    "name": "re-add the reaction",
    "method": "POST", "path": "/reactions",
    "body": { "target_type": "post", "target_id": "${commentPostId}", "emoji": "👍" },
    "expect": { "status": 200, "json": { "reacted": true, "reactions.0.count": 1 } }
  },
  {
    "name": "creating a poll requires at least two options",
    "method": "POST", "path": "/polls",
    "body": { "question": "One?", "options": ["only"] },
    "expect": { "status": 400 }
  },
  {
    "name": "create a poll",
    "method": "POST", "path": "/polls",
    "body": { "question": "Cats or dogs?", "options": ["Cats", "Dogs"], "post_id": "${commentPostId}" },
    "expect": {
      "status": 201,
      "length": { "poll.options": 2 },
      "json": { "poll.question": "Cats or dogs?", "poll.total_votes": 0, "poll.options.1.text": "Dogs" }
    },
    "capture": { "pollId": "poll.id" }
  },
  {
    "name": "read the poll before voting",
    "method": "GET", "path": "/polls/${pollId}",
    "expect": { "status": 200, "json": { "poll.total_votes": 0, "poll.my_vote": null } }
  },
  {
    "name": "cast a vote",
    "method": "POST", "path": "/polls/${pollId}/vote",
    "body": { "option_index": 1 },
    "expect": {
      "status": 200,
      "json": { "poll.total_votes": 1, "poll.my_vote": 1, "poll.options.1.votes": 1, "poll.options.0.votes": 0 }
    }
  },
  {
    "name": "voting twice is rejected",
    "method": "POST", "path": "/polls/${pollId}/vote",
    "body": { "option_index": 0 },
    "expect": { "status": 409 }
  },
  {
    "name": "create a closed poll",
    "method": "POST", "path": "/polls",
    "body": { "question": "Too late?", "options": ["Yes", "No"], "closes_at": "2020-01-01T00:00:00Z" },
    "expect": { "status": 201 },
    "capture": { "closedPollId": "poll.id" }
  },
  {
    "name": "voting on a closed poll is rejected",
    "method": "POST", "path": "/polls/${closedPollId}/vote",
    "body": { "option_index": 0 },
    "expect": { "status": 403 }
  },
  {
    "name": "an unknown poll returns 404",
    "method": "GET", "path": "/polls/does-not-exist",
    "expect": { "status": 404 }
  },
  {
    "name": "settings report auto-approve off by default",
    "method": "GET", "path": "/settings",
    "expect": { "status": 200, "json": { "moderation.auto_approve": false } }
  },
  {
    "name": "enable comment auto-approval",
    "method": "PUT", "path": "/settings",
    "body": { "moderation": { "auto_approve": true } },
    "expect": { "status": 200, "json": { "moderation.auto_approve": true } }
  },
  {
    "name": "a comment posted with auto-approve is immediately approved",
    "method": "POST", "path": "/posts/${commentPostId}/comments",
    "body": { "body": "Auto-approved!" },
    "expect": { "status": 201, "json": { "comment.status": "approved" } }
  },
  {
    "name": "the auto-approved comment is publicly visible without moderation",
    "method": "GET", "path": "/posts/${commentPostId}/comments",
    "expect": { "status": 200, "length": { "comments": 2 } }
  },
  {
    "name": "disable comment auto-approval again",
    "method": "PUT", "path": "/settings",
    "body": { "moderation": { "auto_approve": false } },
    "expect": { "status": 200, "json": { "moderation.auto_approve": false } }
  },
  {
    "name": "create a post that declares a poll in its front matter",
    "method": "POST", "path": "/collections/blog/records",
    "body": {
      "title": "Poll host", "slug": "poll-host", "body": "x", "status": "published",
      "data": { "poll": { "slug": "fav-color", "question": "Favorite color?", "options": ["Red", "Blue"] } }
    },
    "expect": { "status": 201 },
    "capture": { "pollHostId": "record.id" }
  },
  {
    "name": "by-slug resolves and lazily creates the poll from front matter",
    "method": "GET", "path": "/polls/by-slug/fav-color",
    "expect": {
      "status": 200,
      "length": { "poll.options": 2 },
      "json": { "poll.slug": "fav-color", "poll.question": "Favorite color?", "poll.total_votes": 0, "poll.options.1.text": "Blue" }
    },
    "capture": { "slugPollId": "poll.id" }
  },
  {
    "name": "the same slug resolves to the same poll (create-once id)",
    "method": "GET", "path": "/polls/by-slug/fav-color",
    "expect": { "status": 200, "json": { "poll.id": "${slugPollId}" } }
  },
  {
    "name": "vote on the slug-resolved poll",
    "method": "POST", "path": "/polls/${slugPollId}/vote",
    "body": { "option_index": 0 },
    "expect": { "status": 200, "json": { "poll.total_votes": 1, "poll.my_vote": 0 } }
  },
  {
    "name": "edit the poll's question via the post front matter",
    "method": "PUT", "path": "/records/${pollHostId}",
    "body": {
      "slug": "poll-host", "title": "Poll host", "body": "x", "status": "published",
      "data": { "poll": { "slug": "fav-color", "question": "Best color?", "options": ["Red", "Blue"] } }
    },
    "expect": { "status": 200 }
  },
  {
    "name": "re-resolving syncs the text in place but keeps votes",
    "method": "GET", "path": "/polls/by-slug/fav-color",
    "expect": { "status": 200, "json": { "poll.id": "${slugPollId}", "poll.question": "Best color?", "poll.total_votes": 1 } }
  },
  {
    "name": "an unknown poll slug returns 404",
    "method": "GET", "path": "/polls/by-slug/nope",
    "expect": { "status": 404 }
  },

  {
    "name": "owner creates an editor",
    "method": "POST", "path": "/users",
    "body": { "email": "editor2@test.com", "name": "Ed2", "password": "password12345", "role": "editor" },
    "expect": { "status": 201, "json": { "user.role": "editor" } }
  },
  {
    "name": "owner creates a contributor",
    "method": "POST", "path": "/users",
    "body": { "email": "contrib@test.com", "name": "Con", "password": "password12345", "role": "contributor" },
    "expect": { "status": 201, "json": { "user.role": "contributor" } }
  },
  {
    "name": "owner creates a second contributor",
    "method": "POST", "path": "/users",
    "body": { "email": "contrib2@test.com", "name": "Con2", "password": "password12345", "role": "contributor" },
    "expect": { "status": 201, "json": { "user.role": "contributor" } }
  },
  {
    "name": "owner creates an admin",
    "method": "POST", "path": "/users",
    "body": { "email": "admin@test.com", "name": "Adm", "password": "password12345", "role": "admin" },
    "expect": { "status": 201, "json": { "user.role": "admin" } }
  },
  {
    "name": "an admin logs in",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "admin@test.com", "password": "password12345" },
    "expect": { "status": 200, "json": { "user.role": "admin" } }
  },
  {
    "name": "an admin cannot grant owner",
    "method": "POST", "path": "/users",
    "body": { "email": "nope@test.com", "name": "Nope", "password": "password12345", "role": "owner" },
    "expect": { "status": 403 }
  },
  {
    "name": "an admin can grant editor",
    "method": "POST", "path": "/users",
    "body": { "email": "ed3@test.com", "name": "Ed3", "password": "password12345", "role": "editor" },
    "expect": { "status": 201, "json": { "user.role": "editor" } }
  },
  {
    "name": "a contributor logs in",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "contrib@test.com", "password": "password12345" },
    "expect": { "status": 200, "json": { "user.role": "contributor" } }
  },
  {
    "name": "a contributor cannot manage users",
    "method": "GET", "path": "/users",
    "expect": { "status": 403 }
  },
  {
    "name": "a contributor cannot access the review queue",
    "method": "GET", "path": "/records?status=pending",
    "expect": { "status": 403 }
  },
  {
    "name": "a contributor cannot flip a post's status",
    "method": "PUT", "path": "/records/${commentPostId}/status",
    "body": { "status": "draft" },
    "expect": { "status": 403 }
  },
  {
    "name": "a contributor creates a post (published immediately, approval off)",
    "method": "POST", "path": "/collections/blog/records",
    "body": { "title": "Con post", "slug": "con-post", "body": "hi", "status": "draft" },
    "expect": { "status": 201, "json": { "record.status": "published" } },
    "capture": { "conPostId": "record.id" }
  },
  {
    "name": "a contributor can edit their own post",
    "method": "PUT", "path": "/records/${conPostId}",
    "body": { "title": "Con post edited", "slug": "con-post", "body": "hi again", "status": "draft" },
    "expect": { "status": 200, "json": { "record.title": "Con post edited" } }
  },
  {
    "name": "a contributor's record list shows only their own",
    "method": "GET", "path": "/collections/blog/records",
    "expect": { "status": 200, "length": { "records": 1 } }
  },
  {
    "name": "the second contributor logs in",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "contrib2@test.com", "password": "password12345" },
    "expect": { "status": 200, "json": { "user.role": "contributor" } }
  },
  {
    "name": "a contributor cannot read another's post in the editor",
    "method": "GET", "path": "/records/${conPostId}",
    "expect": { "status": 403 }
  },
  {
    "name": "a contributor cannot edit another's post",
    "method": "PUT", "path": "/records/${conPostId}",
    "body": { "title": "hijack", "slug": "con-post", "body": "x", "status": "draft" },
    "expect": { "status": 403 }
  },
  {
    "name": "an editor logs in",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "editor2@test.com", "password": "password12345" },
    "expect": { "status": 200, "json": { "user.role": "editor" } }
  },
  {
    "name": "an editor can edit anyone's post",
    "method": "PUT", "path": "/records/${conPostId}",
    "body": { "title": "Edited by editor", "slug": "con-post", "body": "x", "status": "published" },
    "expect": { "status": 200, "json": { "record.title": "Edited by editor", "record.status": "published" } }
  },
  {
    "name": "owner logs in to require post approval",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "owner turns on post approval",
    "method": "PUT", "path": "/settings",
    "body": { "access": { "require_approval": true } },
    "expect": { "status": 200, "json": { "access.require_approval": true } }
  },
  {
    "name": "the contributor logs back in",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "contrib@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "with approval on, a contributor's post starts pending",
    "method": "POST", "path": "/collections/blog/records",
    "body": { "title": "Needs review", "slug": "needs-review", "body": "hi", "status": "published" },
    "expect": { "status": 201, "json": { "record.status": "pending" } },
    "capture": { "pendingPostId": "record.id" }
  },
  {
    "name": "an editor logs in to publish it",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "editor2@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "the review queue lists the pending post",
    "method": "GET", "path": "/records?status=pending",
    "expect": { "status": 200, "length": { "records": 1 }, "json": { "records.0.id": "${pendingPostId}", "records.0.author_name": "Con" } }
  },
  {
    "name": "an invalid record status is rejected",
    "method": "PUT", "path": "/records/${pendingPostId}/status",
    "body": { "status": "bogus" },
    "expect": { "status": 400 }
  },
  {
    "name": "an editor publishes the pending post from the review queue",
    "method": "PUT", "path": "/records/${pendingPostId}/status",
    "body": { "status": "published" },
    "expect": { "status": 200, "json": { "record.status": "published" } }
  },
  {
    "name": "the review queue is now empty",
    "method": "GET", "path": "/records?status=pending",
    "expect": { "status": 200, "length": { "records": 0 } }
  },
  {
    "name": "a visitor signs in to comment on the contributor's post",
    "method": "POST", "path": "/auth/request-code",
    "body": { "email": "commenter@test.com" },
    "expect": { "status": 200 },
    "capture": { "otp2": "code" }
  },
  {
    "name": "the visitor verifies",
    "method": "POST", "path": "/auth/verify-code",
    "body": { "email": "commenter@test.com", "code": "${otp2}" },
    "expect": { "status": 200, "json": { "user.role": "member" } }
  },
  {
    "name": "the visitor comments on the contributor's post",
    "method": "POST", "path": "/posts/${conPostId}/comments",
    "body": { "body": "Nice one" },
    "expect": { "status": 201, "json": { "comment.status": "pending" } },
    "capture": { "conCommentId": "comment.id" }
  },
  {
    "name": "the post author (contributor) logs in to moderate",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "contrib@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "the contributor sees the comment on their own post in the queue",
    "method": "GET", "path": "/comments?status=pending",
    "expect": { "status": 200, "length": { "comments": 1 }, "json": { "comments.0.id": "${conCommentId}" } }
  },
  {
    "name": "the author can moderate inline on their own post (can_moderate + pending visible)",
    "method": "GET", "path": "/posts/${conPostId}/comments",
    "expect": { "status": 200, "json": { "can_moderate": true, "comments.0.id": "${conCommentId}", "comments.0.status": "pending" } }
  },
  {
    "name": "the contributor approves a comment on their own post",
    "method": "PUT", "path": "/comments/${conCommentId}",
    "body": { "status": "approved" },
    "expect": { "status": 200, "json": { "comment.status": "approved" } }
  },
  {
    "name": "another contributor cannot moderate that comment",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "contrib2@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "a non-author contributor is refused moderation",
    "method": "PUT", "path": "/comments/${conCommentId}",
    "body": { "status": "rejected" },
    "expect": { "status": 403 }
  },
  {
    "name": "the second contributor's own moderation queue is empty",
    "method": "GET", "path": "/comments?status=approved",
    "expect": { "status": 200, "length": { "comments": 0 } }
  },
  {
    "name": "owner logs in for ownership-integrity checks",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "owner turns approval back off",
    "method": "PUT", "path": "/settings",
    "body": { "access": { "require_approval": false } },
    "expect": { "status": 200, "json": { "access.require_approval": false } }
  },
  {
    "name": "the sole owner cannot demote themselves",
    "method": "PUT", "path": "/users/${ownerId}",
    "body": { "role": "admin" },
    "expect": { "status": 409 }
  },
  {
    "name": "owner promotes the admin to co-owner",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "admin@test.com", "password": "password12345" },
    "expect": { "status": 200 },
    "capture": { "adminId": "user.id" }
  },
  {
    "name": "owner logs back in and grants co-ownership",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "grant owner to the admin",
    "method": "PUT", "path": "/users/${adminId}",
    "body": { "role": "owner" },
    "expect": { "status": 200, "json": { "user.role": "owner" } }
  },
  {
    "name": "with a co-owner, the owner may now step down",
    "method": "PUT", "path": "/users/${ownerId}",
    "body": { "role": "admin" },
    "expect": { "status": 200, "json": { "user.role": "admin" } }
  },

  {
    "name": "an editor attaches a location to a target",
    "method": "POST", "path": "/locations",
    "body": { "target_type": "post", "target_id": "p1", "lat": 40.5, "lng": -74.25, "label": "NYC" },
    "expect": { "status": 201, "json": { "location.label": "NYC", "location.lat": 40.5 } },
    "capture": { "locationId": "location.id" }
  },
  {
    "name": "locations are listed for a target",
    "method": "GET", "path": "/locations?target_type=post&target_id=p1",
    "expect": { "status": 200, "length": { "locations": 1 }, "json": { "locations.0.id": "${locationId}", "locations.0.label": "NYC" } }
  },
  {
    "name": "listing locations needs a target",
    "method": "GET", "path": "/locations",
    "expect": { "status": 400 }
  },
  {
    "name": "out-of-range coordinates are rejected",
    "method": "POST", "path": "/locations",
    "body": { "target_type": "post", "target_id": "p1", "lat": 200, "lng": 0 },
    "expect": { "status": 400 }
  },
  {
    "name": "a contributor cannot attach a location",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "contrib2@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "location tagging is editor+ only",
    "method": "POST", "path": "/locations",
    "body": { "target_type": "post", "target_id": "p1", "lat": 0, "lng": 0 },
    "expect": { "status": 403 }
  },
  {
    "name": "admin logs back in after the location checks",
    "method": "POST", "path": "/auth/login",
    "body": { "email": "owner@test.com", "password": "password12345" },
    "expect": { "status": 200 }
  },
  {
    "name": "delete the location",
    "method": "DELETE", "path": "/locations/${locationId}",
    "expect": { "status": 204 }
  },
  {
    "name": "listing files needs a record",
    "method": "GET", "path": "/files",
    "expect": { "status": 400 }
  },
  {
    "name": "a record with no media lists no files",
    "method": "GET", "path": "/files?record_type=post&record_id=p1",
    "expect": { "status": 200, "length": { "files": 0 } }
  },
  {
    "name": "an admin creates a channel",
    "method": "POST", "path": "/channels",
    "body": { "name": "General", "kind": "feed" },
    "expect": { "status": 201, "json": { "channel.name": "General", "channel.kind": "feed" } },
    "capture": { "channelId": "channel.id" }
  },
  {
    "name": "channels are listed publicly",
    "method": "GET", "path": "/channels",
